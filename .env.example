APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tour_booking
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Shared image storage (business data remains in MySQL).
MEDIA_DRIVER=supabase
SUPABASE_URL=
SUPABASE_STORAGE_BUCKET=tour-images
# Server-only sb_secret_ key; never expose in VITE_ or commit .env.
SUPABASE_SECRET_KEY=
# Optional CA bundle path on Windows when PHP has no system CA configured.
MEDIA_CA_BUNDLE=
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Local classroom demo only. QR simulation is always disabled in production.
PAYMENT_DEMO_ENABLED=false
PAYMENT_QR_LIFETIME_MINUTES=10

# SePay Payment Gateway - sandbox only (never use production credentials here)
SEPAY_SANDBOX_ENABLED=false
SEPAY_SANDBOX_MERCHANT_ID=
SEPAY_SANDBOX_SECRET_KEY=
SEPAY_SANDBOX_IPN_SECRET=
SEPAY_SANDBOX_PUBLIC_URL=
